<resources>
    <!--
        The UI is drawn entirely by Compose with a dark Material 3 color scheme.
        This XML theme only needs to be a Material3 base so the Activity window
        (status bar background, no action bar) is set up before Compose draws.
    -->
    <style name="Theme.VideoTrimmer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
